<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M2P5"/>
        <attribute name="authors" value="herna"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-02 01:30:13 PM"/>
        <attribute name="created" value="aGVybmE7RlJJSk9MOzIwMjYtMDgtMzE7MDQ6NDQ6NDQgUE07MjI2Ng=="/>
        <attribute name="edited" value="aGVybmE7RlJJSk9MOzIwMjYtMDktMDI7MDE6MzA6MTMgUE07NDsyMzY0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="price" type="Real" array="False" size=""/>
            <declare name="discount" type="Real" array="False" size=""/>
            <declare name="item" type="Real" array="False" size=""/>
            <input variable="price"/>
            <input variable="discount"/>
            <assign variable="item" expression="price - price * discount"/>
            <assign variable="discount" expression="100 * discount"/>
            <output expression="&quot;Item is $&quot; &amp;item &amp;&quot; at a &quot; &amp;discount &amp;&quot;% discount&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
