<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M2P3"/>
        <attribute name="authors" value="herna"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-02 01:26:09 PM"/>
        <attribute name="created" value="aGVybmE7RlJJSk9MOzIwMjYtMDgtMzE7MDQ6MjY6NDYgUE07MjI2OA=="/>
        <attribute name="edited" value="aGVybmE7RlJJSk9MOzIwMjYtMDktMDI7MDE6MjY6MDkgUE07MzsyMzcz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="length" type="Real" array="False" size=""/>
            <declare name="width" type="Real" array="False" size=""/>
            <declare name="area" type="Real" array="False" size=""/>
            <declare name="circumference" type="Real" array="False" size=""/>
            <input variable="length"/>
            <input variable="width"/>
            <assign variable="area" expression="length * width"/>
            <assign variable="circumference" expression="2 * length + 2 * width"/>
            <output expression="&quot;Your area is &quot; &amp;area" newline="True"/>
            <output expression="&quot;Your circumference is &quot;    &amp;  circumference" newline="True"/>
        </body>
    </function>
</flowgorithm>
